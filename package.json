{
  "name": "ai-credit-originator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @credit/api dev",
    "dev:web": "pnpm --filter @credit/web dev",
    "db:migrate": "tsx database/migrate.ts",
    "db:reset": "tsx database/migrate.ts --reset",
    "seed": "tsx database/seed.ts",
    "eval": "tsx evaluation/run.ts",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "pnpm -r --if-present build",
    "test": "tsx --test packages/contracts/src/*.test.ts database/*.test.ts",
    "test:db": "tsx --test apps/api/src/**/*.test.ts",
    "test:all": "pnpm test && pnpm test:db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@credit/contracts": "workspace:*",
    "@credit/policies": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "packageManager": "pnpm@10.15.0"
}
