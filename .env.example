# ---- Base de datos ----
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit_originator
POSTGRES_PORT=5433
DATABASE_URL=postgresql://credit:credit@localhost:5433/credit_originator

# ---- API ----
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---- Determinismo ----
# Alimenta el generador del dataset y, cuando el modelo lo soporta, la semilla
# de inferencia que se envia a OpenRouter (agent_runs.inference_seed).
SEED=20260907

# ---- Versionado (se registra en agent_runs) ----
PROMPT_VERSION=v1
POLICY_CORPUS_VERSION=1.0
INDICATOR_CALC_VERSION=1

# ---- Proveedor LLM ----
# La key de OpenRouter tiene el formato sk-or-v1-<64 caracteres hex>.
# Si pegas solo la parte hexadecimal, falta el prefijo y el proveedor responde 401.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slug de un modelo CONCRETO. No usar 'openrouter/free': es un enrutador entre
# modelos gratuitos y cada corrida puede resolver a uno distinto, lo que rompe
# la reproducibilidad de la evaluacion. El modelo realmente usado queda
# registrado en agent_runs.resolved_model.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Alternativa a probar:
#   nvidia/nemotron-3-super-120b-a12b:free
AGENT_PROVIDER=direct

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
